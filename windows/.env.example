# Rename this file to .env and paste an API key below.
# Without a key, Voza works in fully local mode (free).

# RECOMMENDED: Groq — fastest transcription (~200x realtime), ~$0.04/hr of audio.
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_paste-your-key-here

# Alternative: OpenAI (used only if no Groq key is set).
# Get a key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-paste-your-key-here
